# Edit these paths before running on a new machine.
BASE_MODEL=/path/to/Llama-3.1-8B-Instruct
TOKENIZER_PATH=/path/to/Llama-3.1-8B-Instruct

# Training defaults used by the paper runs.
MODEL_NAME=causal
NUM_EPOCHS=2
OBJECTIVE_SCHEDULE=anchor,distribution
GPUS=0
NUM_PROCESSES=1
BATCH_SIZE=8
LEARNING_RATE=2e-5
GRADIENT_ACCUMULATION_STEPS=1
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

# Inference defaults.
EVAL_BATCH_SIZE=256
GPU_LIST=0
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=4096
MAX_LORA_RANK=16
